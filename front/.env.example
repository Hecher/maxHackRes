# ─────────────────────────────────────────────────────────────────────
# Переменные окружения мини-приложения ВЛР.
#
# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env
#
# Рабочих токенов, паролей и ключей здесь нет и быть не должно:
# репозиторий сдаётся вместе с исходным кодом.
# ─────────────────────────────────────────────────────────────────────

# Адрес бэкенда. Приложение работает только с сервером: локальных
# тестовых наборов данных в нём нет.
#
# Локально (docker compose в репозитории бэкенда):
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Задеплоенный бэкенд — укажите его https-адрес, например:
# VITE_API_BASE_URL=https://api.example.ru/api/v1

# Ник бота в MAX. Из него собираются диплинки для шеринга работ:
#   https://max.ru/<botName>?startapp=lab_<id>-mode_work
VITE_MAX_BOT_NAME=vlr_bot

# Порт, на котором мини-приложение будет доступно локально.
# Используется только docker compose.
WEB_PORT=8080
