# ─────────────────────────────────────────────────────────────────────
# Переменные окружения бэкенда ВЛР.
#
# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
#
# Настоящий BOT_TOKEN и JWT_SECRET_KEY в репозиторий не попадают.
# ─────────────────────────────────────────────────────────────────────

# Режим разработки. Включает /auth/dev-login (вход без подписи MAX)
# и подробное логирование SQL.
# В проде обязательно false — иначе любой сможет войти под чужим id.
DEBUG=true

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vlr_db

# JWT: подпись сессий мини-приложения (7 дней)
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Токен бота MAX. Нужен для двух вещей:
#  1) проверка подписи initData, которую присылает мини-приложение;
#  2) запуск самого бота (команды и уведомления).
# Без настоящего токена API работает, а бот пишет предупреждение в лог.
BOT_TOKEN=mock_bot_token

# Адрес мини-приложения: бот даёт на него кнопку и присылает ссылки
# в уведомлениях.
MINIAPP_URL=https://osleek.github.io/max-miniapp-react-test/

# Откуда разрешены запросы к API (CORS). По умолчанию — отовсюду,
# потому что мини-приложение открывается с https-хостинга и с локального
# dev-сервера. В проде укажите конкретные источники:
#   CORS_ORIGINS=["https://osleek.github.io"]
CORS_ORIGINS=["*"]
